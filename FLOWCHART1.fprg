<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="ISATU BAH"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-17 10:43:21 PM"/>
        <attribute name="created" value="SVNBVFUgQkFIO0lTQVRVOzIwMjYtMTAtMTc7MDg6MzE6MjEgUE07MjI5Mw=="/>
        <attribute name="edited" value="SVNBVFUgQkFIO0lTQVRVOzIwMjYtMTAtMTc7MTA6NDM6MjEgUE07MjsyMzk4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Choice" type="Integer" array="False" size=""/>
            <assign variable="choice" expression="0"/>
            <while expression="choice!=5">
                <output expression="&quot;STUDENT MANAGEMENT SYSTEM&quot;" newline="True"/>
                <output expression="&quot;1.Register Student&quot;" newline="True"/>
                <output expression="&quot;2.Mark Attendance&quot;" newline="True"/>
                <output expression="&quot;3.Record Scores&quot;" newline="True"/>
                <output expression="&quot;4.Generate Report&quot;" newline="True"/>
                <output expression="&quot;5.Exit&quot;" newline="True"/>
                <input variable="choice"/>
                <if expression="choice==1">
                    <then>
                        <output expression="&quot;Register Student&quot;" newline="True"/>
                    </then>
                    <else>
                        <if expression="choice==2">
                            <then>
                                <output expression="&quot;Mark Attendance&quot;" newline="True"/>
                            </then>
                            <else>
                                <if expression="choice==3">
                                    <then>
                                        <output expression="&quot;Record Scores&quot;" newline="True"/>
                                    </then>
                                    <else>
                                        <if expression="CHOICE==4">
                                            <then>
                                                <output expression="&quot;Generate Reports&quot;" newline="True"/>
                                            </then>
                                            <else>
                                                <if expression="choice==5">
                                                    <then>
                                                        <output expression="&quot;Exit&quot;" newline="True"/>
                                                    </then>
                                                    <else>
                                                        <output expression="&quot;Invalid choice&quot;" newline="True"/>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
        </body>
    </function>
</flowgorithm>
