<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="ISATU BAH"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-18 06:29:04 PM"/>
        <attribute name="created" value="SVNBVFUgQkFIO0lTQVRVOzIwMjYtMTAtMTg7MDQ6NTE6MDEgUE07MjI5MA=="/>
        <attribute name="edited" value="SVNBVFUgQkFIO0lTQVRVOzIwMjYtMTAtMTg7MDY6Mjk6MDQgUE07MzsyNDEw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="attendance" type="Integer" array="True" size="3"/>
            <assign variable="attendance[0]" expression="20"/>
            <assign variable="attendance[1]" expression="28"/>
            <assign variable="attendance[2]" expression="15"/>
            <declare name="test1" type="Integer" array="True" size="3"/>
            <assign variable="test1[0]" expression="40"/>
            <assign variable="test1[1]" expression="80"/>
            <assign variable="test1[2]" expression="30"/>
            <declare name="test2" type="Integer" array="True" size="3"/>
            <assign variable="test2[0]" expression="45"/>
            <assign variable="test2[1]" expression="75"/>
            <assign variable="test2[2]" expression="35"/>
            <call expression="GenerateReport"/>
        </body>
    </function>
    <function name="GenerateReport" type="None" variable="">
        <parameters/>
        <body>
            <declare name="totalstudents" type="Integer" array="False" size=""/>
            <assign variable="totalstudents" expression="3"/>
            <declare name="totalclasses" type="Integer" array="False" size=""/>
            <assign variable="totalclasses" expression="30"/>
            <declare name="attendance" type="Integer" array="True" size="3"/>
            <declare name="test1" type="Integer" array="True" size="3"/>
            <declare name="test2" type="Integer" array="True" size="3"/>
            <declare name="atRiskcount" type="Integer" array="False" size=""/>
            <assign variable="atRiskcount" expression="0"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="i" expression="0"/>
            <while expression="i&lt;totalstudents">
                <declare name="AttendancePercent" type="Real" array="False" size=""/>
                <assign variable="AttendancePercent" expression="(attendance[i]/totalclasses)*100"/>
                <declare name="Average" type="Real" array="False" size=""/>
                <assign variable="Average" expression="(test1[i]+test2[i])/2"/>
                <declare name="status" type="String" array="False" size=""/>
                <if expression="Attendancepercent&lt;75&amp;&amp;Average&lt;50">
                    <then>
                        <assign variable="status" expression="&quot;HIGH RISK&quot;"/>
                        <assign variable="atRiskcount" expression="atRiskcount+1"/>
                    </then>
                    <else>
                        <if expression="Attendancepercent&lt;75 or Average&lt;50">
                            <then>
                                <assign variable="status" expression="&quot;AT RISK&quot;"/>
                                <assign variable="atRiskcount" expression="atRiskcount+1"/>
                            </then>
                            <else>
                                <assign variable="status" expression="&quot;GOOD STANDIMG&quot;"/>
                            </else>
                        </if>
                    </else>
                </if>
                <assign variable="i" expression="i+1"/>
            </while>
            <output expression="&quot;TotalAtRisk:&quot;&amp;atRiskcount" newline="True"/>
        </body>
    </function>
</flowgorithm>
